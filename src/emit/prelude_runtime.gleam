  <> "  let out : Array[T] = []\n"
  <> "  for cur = self {\n"
  <> "    match cur {\n"
  <> "      Nil => break out\n"
  <> "      Cons(head, tail) => {\n"
  <> "        out.push(head)\n"
  <> "        continue tail\n"
  <> "      }\n"
  <> "    }\n"
  <> "  }\n"
  <> "}\n"
  <> "\n"
  <> "///|\n"
  <> "pub fn[T] GList::from_array(arr : ArrayView[T]) -> GList[T] {\n"
  <> "  let mut acc : GList[T] = Nil\n"
  <> "  let mut i = arr.length() - 1\n"
  <> "  while i >= 0 {\n"
  <> "    acc = Cons(arr[i], acc)\n"
  <> "    i = i - 1\n"
  <> "  }\n"
  <> "  acc\n"
  <> "}\n"
  <> "\n"
  <> "///|\n"
