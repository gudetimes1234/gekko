  <> "  let len = self.data.length().to_int64()\n"
  <> "  let start = if at < 0L { len + at } else { at }\n"
  <> "  if start < 0L || take < 0L || start + take > len {\n"
  <> "    Err(())\n"
  <> "  } else {\n"
  <> "    let view = self.data[start.to_int():(start + take).to_int()]\n"
