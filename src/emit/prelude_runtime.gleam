  <> "      buf.write_int64_le(val)\n"
  <> "    }\n"
  <> "  } else {\n"
  <> "    @prelude.abort(\"unsupported non-byte-aligned bit segment width in Tier 1 BitArray\")\n"
  <> "  }\n"
  <> "  { data: buf.to_bytes() }\n"
  <> "}\n"
  <> "\n"
