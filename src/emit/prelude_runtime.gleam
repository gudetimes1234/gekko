  <> "    DynString(s) => {\n"
  <> "      hasher.combine_int(4)\n"
  <> "      hasher.combine(s)\n"
  <> "    }\n"
  <> "    DynBitArray(ba) => {\n"
  <> "      hasher.combine_int(5)\n"
  <> "      hasher.combine(ba)\n"
  <> "    }\n"
  <> "    DynList(xs) => {\n"
  <> "      hasher.combine_int(6)\n"
  <> "      hasher.combine(xs)\n"
  <> "    }\n"
  <> "    DynArray(arr) => {\n"
  <> "      hasher.combine_int(7)\n"
