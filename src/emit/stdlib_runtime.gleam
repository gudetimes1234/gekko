fn string_pkg() -> ShimPackage {
  ShimPackage(
    module_name: "gleam/string",
    pkg_dir: "gleam_string",
    imports: [
      #("gprelude", "gprelude"),
      #("gleam_order", "gleam_order"),
      #("moonbitlang/core/debug", "debug"),
      #("moonbitlang/core/encoding/utf8", "utf8"),
    ],
    deps: ["gleam/order"],
    source: string.join(
      [
        "///|",
        "pub fn is_empty(s : String) -> Bool { s == \"\" }",
        "",
        "///|",
        "pub fn length(s : String) -> Int64 {",
        "  s.iter().count().to_int64()",
        "}",
        "",
        "///|",
        "pub fn reverse(s : String) -> String {",
        "  let chars = s.iter().collect()",
        "  let buf = StringBuilder()",
        "  let mut i = chars.length() - 1",
        "  while i >= 0 {",
        "    buf.write_char(chars[i])",
        "    i = i - 1",
        "  }",
        "  buf.to_string()",
        "}",
        "",
        "///|",
        "pub fn replace(in_ : String, each : String, with_ : String) -> String {",
        "  in_.replace_all(old=each, new=with_)",
        "}",
        "",
        "///|",
        "pub fn lowercase(s : String) -> String { s.to_lower() }",
        "",
        "///|",
        "pub fn uppercase(s : String) -> String { s.to_upper() }",
        "",
        "///|",
        "pub fn compare(a : String, b : String) -> @gleam_order.Order {",
        "  if a < b { @gleam_order.Lt } else if a > b { @gleam_order.Gt } else { @gleam_order.Eq }",
        "}",
        "",
        "///|",
        "pub fn slice(from : String, at_index : Int64, length_ : Int64) -> String {",
        "  if length_ <= 0L { return \"\" }",
        "  let chars = from.iter().collect()",
        "  let total = chars.length()",
        "  let mut start = at_index.to_int()",
        "  if start < 0 { start = total + start }",
        "  if start < 0 || start >= total { return \"\" }",
        "  let mut end = start + length_.to_int()",
        "  if end > total { end = total }",
        "  let buf = StringBuilder()",
        "  let mut i = start",
        "  while i < end {",
        "    buf.write_char(chars[i])",
        "    i = i + 1",
        "  }",
        "  buf.to_string()",
        "}",
        "",
        "///|",
        "pub fn crop(from : String, before : String) -> String {",
        "  match from.find(before) {",
        "    Some(idx) => from.unsafe_substring(start=idx, end=from.length())",
        "    None => from",
        "  }",
        "}",
        "",
        "///|",
        "pub fn drop_start(from : String, up_to : Int64) -> String {",
        "  if up_to <= 0L { return from }",
        "  let chars = from.iter().collect()",
        "  let start = up_to.to_int()",
        "  if start >= chars.length() { return \"\" }",
        "  let buf = StringBuilder()",
        "  let mut i = start",
        "  while i < chars.length() {",
        "    buf.write_char(chars[i])",
        "    i = i + 1",
        "  }",
        "  buf.to_string()",
        "}",
        "",
        "///|",
        "pub fn drop_end(from : String, up_to : Int64) -> String {",
        "  if up_to <= 0L { return from }",
        "  let chars = from.iter().collect()",
        "  let keep = chars.length() - up_to.to_int()",
        "  if keep <= 0 { return \"\" }",
        "  let buf = StringBuilder()",
        "  let mut i = 0",
        "  while i < keep {",
        "    buf.write_char(chars[i])",
        "    i = i + 1",
        "  }",
        "  buf.to_string()",
        "}",
        "",
        "///|",
        "pub fn contains(does : String, contain : String) -> Bool {",
        "  does.contains(contain)",
        "}",
        "",
        "///|",
        "pub fn starts_with(s : String, prefix : String) -> Bool {",
        "  s.has_prefix(prefix)",
        "}",
        "",
        "///|",
        "pub fn ends_with(s : String, suffix : String) -> Bool {",
        "  s.has_suffix(suffix)",
        "}",
        "",
        "///|",
        "pub fn split(x : String, on : String) -> @gprelude.GList[String] {",
        "  if on == \"\" {",
        "    return to_graphemes(x)",
        "  }",
        "  let parts : Array[String] = []",
        "  for view in x.split(on) {",
        "    parts.push(view.to_owned())",
        "  }",
        "  @gprelude.GList::from_array(parts[:])",
        "}",
        "",
        "///|",
        "pub fn split_once(s : String, on : String) -> Result[(String, String), Unit] {",
        "  match s.split_once(on) {",
        "    Some((a, b)) => Ok((a.to_owned(), b.to_owned()))",
        "    None => Err(())",
        "  }",
        "}",
        "",
        "///|",
        "pub fn append(to : String, suffix : String) -> String { to + suffix }",
        "",
        "///|",
        "pub fn concat(strings : @gprelude.GList[String]) -> String {",
        "  let buf = StringBuilder()",
        "  for cur = strings {",
        "    match cur {",
        "      @gprelude.Nil => break buf.to_string()",
        "      @gprelude.Cons(s, rest) => {",
        "        buf.write_string(s)",
        "        continue rest",
        "      }",
        "    }",
        "  }",
        "}",
        "",
        "///|",
        "pub fn repeat(s : String, times : Int64) -> String {",
        "  if times <= 0L { return \"\" }",
        "  let buf = StringBuilder()",
        "  let mut i = 0L",
        "  while i < times {",
        "    buf.write_string(s)",
        "    i = i + 1L",
        "  }",
        "  buf.to_string()",
        "}",
        "",
        "///|",
        "pub fn join(strings : @gprelude.GList[String], with_ : String) -> String {",
        "  let buf = StringBuilder()",
        "  for cur = strings, first = true {",
        "    match cur {",
        "      @gprelude.Nil => break buf.to_string()",
        "      @gprelude.Cons(s, rest) => {",
        "        if !first { buf.write_string(with_) }",
        "        buf.write_string(s)",
        "        continue rest, false",
        "      }",
        "    }",
        "  }",
        "}",
        "",
        "///|",
        "pub fn pad_start(s : String, to : Int64, with_ : String) -> String {",
        "  let len = length(s)",
        "  if len >= to || with_ == \"\" { return s }",
        "  let needed = to - len",
        "  let pad_len = length(with_)",
        "  let reps = (needed + pad_len - 1L) / pad_len",
        "  let padded = slice(repeat(with_, reps), 0L, needed)",
        "  padded + s",
        "}",
        "",
        "///|",
        "pub fn pad_end(s : String, to : Int64, with_ : String) -> String {",
        "  let len = length(s)",
        "  if len >= to || with_ == \"\" { return s }",
        "  let needed = to - len",
        "  let pad_len = length(with_)",
        "  let reps = (needed + pad_len - 1L) / pad_len",
        "  let padded = slice(repeat(with_, reps), 0L, needed)",
        "  s + padded",
        "}",
        "",
        "///|",
        "pub fn trim(s : String) -> String { s.trim().to_owned() }",
        "",
        "///|",
        "pub fn trim_start(s : String) -> String {",
        "  s.trim_start(chars=\" \\t\\n\\r\\u{000B}\\u{000C}\").to_owned()",
        "}",
        "",
        "///|",
        "pub fn trim_end(s : String) -> String {",
        "  s.trim_end(chars=\" \\t\\n\\r\\u{000B}\\u{000C}\").to_owned()",
        "}",
        "",
        "///|",
        "pub fn pop_grapheme(s : String) -> Result[(String, String), Unit] {",
        "  if s == \"\" { return Err(()) }",
        "  let first_ch = slice(s, 0L, 1L)",
        "  let rest = drop_start(s, 1L)",
        "  Ok((first_ch, rest))",
        "}",
        "",
        "///|",
        "pub fn to_graphemes(s : String) -> @gprelude.GList[String] {",
        "  let out : Array[String] = []",
        "  for ch in s {",
        "    out.push(ch.to_string())",
        "  }",
        "  @gprelude.GList::from_array(out[:])",
        "}",
        "",
        "///|",
        "pub fn to_option(s : String) -> Option[String] {",
        "  if s == \"\" { None } else { Some(s) }",
        "}",
        "",
        "///|",
        "pub fn first(s : String) -> Result[String, Unit] {",
        "  if s == \"\" { Err(()) } else { Ok(slice(s, 0L, 1L)) }",
        "}",
        "",
        "///|",
        "pub fn last(s : String) -> Result[String, Unit] {",
        "  let len = length(s)",
        "  if len == 0L { Err(()) } else { Ok(slice(s, len - 1L, 1L)) }",
        "}",
        "",
        "///|",
        "pub fn capitalise(s : String) -> String {",
        "  match pop_grapheme(s) {",
        "    Ok((f, rest)) => f.to_upper() + rest.to_lower()",
        "    Err(_) => \"\"",
        "  }",
        "}",
        "",
        "///|",
        "pub fn[T : @debug.Debug] inspect(term : T) -> String {",
        "  @debug.to_string(term)",
        "}",
        "",
        "///|",
        "pub fn byte_size(s : String) -> Int64 {",
        "  @utf8.encode(s).length().to_int64()",
        "}",
        "",
        "///|",
        "pub fn remove_prefix(from : String, matching : String) -> String {",
        "  if from.has_prefix(matching) {",
        "    from.unsafe_substring(start=matching.length(), end=from.length())",
        "  } else {",
        "    from",
        "  }",
        "}",
        "",
        "///|",
        "pub fn remove_suffix(from : String, matching : String) -> String {",
        "  if from.has_suffix(matching) {",
        "    from.unsafe_substring(start=0, end=from.length() - matching.length())",
        "  } else {",
        "    from",
        "  }",
        "}",
        "",
      ],
      "\n",
    ),
  )
}

