        "",
        "///|",
        "pub fn remainder(dividend : Int64, divisor : Int64) -> Result[Int64, Unit] {",
        "  if divisor == 0L { Err(()) } else { Ok(dividend % divisor) }",
        "}",
        "",
        "///|",
        "pub fn modulo(dividend : Int64, divisor : Int64) -> Result[Int64, Unit] {",
        "  if divisor == 0L {",
        "    Err(())",
        "  } else {",
        "    let rem = dividend % divisor",
        "    if (rem > 0L && divisor < 0L) || (rem < 0L && divisor > 0L) {",
        "      Ok(rem + divisor)",
        "    } else {",
        "      Ok(rem)",
        "    }",
        "  }",
        "}",
        "",
        "///|",
        "pub fn floor_divide(dividend : Int64, divisor : Int64) -> Result[Int64, Unit] {",
        "  if divisor == 0L {",
        "    Err(())",
        "  } else {",
        "    let q = dividend / divisor",
        "    let r = dividend % divisor",
        "    if r != 0L && ((dividend < 0L) != (divisor < 0L)) {",
        "      Ok(q - 1L)",
        "    } else {",
        "      Ok(q)",
        "    }",
        "  }",
        "}",
        "",
        "///|",
        "pub fn add(a : Int64, b : Int64) -> Int64 { a + b }",
        "",
        "///|",
        "pub fn multiply(a : Int64, b : Int64) -> Int64 { a * b }",
        "",
        "///|",
        "pub fn subtract(a : Int64, b : Int64) -> Int64 { a - b }",
        "",
        "///|",
        "pub fn bitwise_and(x : Int64, y : Int64) -> Int64 { x & y }",
        "",
        "///|",
        "pub fn bitwise_not(x : Int64) -> Int64 { x.lnot() }",
        "",
        "///|",
        "pub fn bitwise_or(x : Int64, y : Int64) -> Int64 { x | y }",
        "",
        "///|",
        "pub fn bitwise_exclusive_or(x : Int64, y : Int64) -> Int64 { x ^ y }",
        "",
        "///|",
        "pub fn bitwise_shift_left(x : Int64, y : Int64) -> Int64 { x << y.to_int() }",
        "",
        "///|",
        "pub fn bitwise_shift_right(x : Int64, y : Int64) -> Int64 { x >> y.to_int() }",
        "",
        "///|",
        "pub fn[A] range(start : Int64, stop : Int64, acc : A, reducer : (A, Int64) -> A) -> A {",
        "  if start < stop {",
        "    for i = start, cur = acc {",
        "      if i >= stop { break cur } else { continue i + 1L, reducer(cur, i) }",
        "    }",
        "  } else if start > stop {",
        "    for i = start, cur = acc {",
        "      if i <= stop { break cur } else { continue i - 1L, reducer(cur, i) }",
        "    }",
        "  } else {",
        "    acc",
        "  }",
        "}",
        "",
      ],
      "\n",
    ),
  )
}

