        "  for cur = entries {",
        "    match cur {",
        "      @gprelude.Nil => break @gprelude.DynMap(m)",
        "      @gprelude.Cons((k, v), rest) => {",
        "        let key_str = match k {",
        "          @gprelude.DynString(s) => s",
        "          @gprelude.DynInt(i) => i.to_string()",
        "          @gprelude.DynFloat(f) => f.to_string()",
        "          @gprelude.DynBool(b) => if b { \"true\" } else { \"false\" }",
        "          _ => \"\"",
        "        }",
        "        m.set(key_str, v)",
        "        continue rest",
        "      }",
        "    }",
        "  }",
        "}",
        "",
        "///|",
        "pub fn nil() -> @gprelude.Dynamic { @gprelude.DynNull }",
        "",
      ],
      "\n",
    ),
  )
}

fn decode_pkg() -> ShimPackage {
  ShimPackage(
    module_name: "gleam/dynamic/decode",
    pkg_dir: "gleam_dynamic_decode",
    imports: [
      #("gprelude", "gprelude"),
      #("gleam_dict", "gleam_dict"),
      #("gleam_dynamic", "gleam_dynamic"),
    ],
    deps: ["gleam/dict", "gleam/dynamic"],
    source: string.join(
      [
        "///|",
        "pub type Dynamic = @gprelude.Dynamic",
        "",
        "///|",
        "#derive(Eq, Debug, Hash)",
        "pub(all) enum DecodeError {",
        "  DecodeError(expected~ : String, found~ : String, path~ : @gprelude.GList[String])",
        "}",
        "",
        "///|",
        "pub(all) enum Decoder[T] {",
        "  Decoder((@gprelude.Dynamic) -> (T, @gprelude.GList[DecodeError]))",
        "}",
        "",
        "///|",
        "pub(all) enum DynamicKey {",
        "  KeyString(String)",
        "  KeyInt(Int64)",
        "}",
        "",
        "///|",
        "pub(open) trait DecodeKey {",
        "  to_decode_key(Self) -> DynamicKey",
        "}",
        "",
        "///|",
        "pub impl DecodeKey for String with to_decode_key(self) { KeyString(self) }",
        "",
        "///|",
        "pub impl DecodeKey for Int64 with to_decode_key(self) { KeyInt(self) }",
        "",
        "///|",
        "fn key_to_string(k : DynamicKey) -> String {",
        "  match k {",
        "    KeyString(s) => s",
        "    KeyInt(i) => i.to_string()",
        "  }",
        "}",
        "",
        "///|",
        "fn bare_index(data : @gprelude.Dynamic, key : DynamicKey) -> Result[Option[@gprelude.Dynamic], String] {",
        "  match (data, key) {",
        "    (@gprelude.DynMap(m), KeyString(s)) => Ok(match m.get(s) { Some(v) => Some(v); None => None })",
        "    (@gprelude.DynMap(_), KeyInt(_)) => Ok(None)",
        "    (@gprelude.DynArray(arr), KeyInt(idx)) => {",
        "      if idx >= 0L && idx.to_int() < arr.length() { Ok(Some(arr[idx.to_int()])) } else { Ok(None) }",
        "    }",
        "    (@gprelude.DynList(xs), KeyInt(idx)) => {",
        "      if idx < 0L { return Ok(None) }",
        "      for cur = xs, i = 0L {",
        "        match cur {",
        "          @gprelude.Nil => break Ok(None)",
        "          @gprelude.Cons(v, rest) => if i == idx { break Ok(Some(v)) } else { continue rest, i + 1L }",
        "        }",
        "      }",
        "    }",
        "    (@gprelude.DynArray(_), KeyString(_)) | (@gprelude.DynList(_), KeyString(_)) => Ok(None)",
        "    _ => Err(\"Indexable\")",
        "  }",
        "}",
        "",
        "///|",
        "fn append_lists(a : @gprelude.GList[DecodeError], b : @gprelude.GList[DecodeError]) -> @gprelude.GList[DecodeError] {",
        "  for cur = a.reverse(), acc = b {",
        "    match cur {",
        "      @gprelude.Nil => break acc",
        "      @gprelude.Cons(x, rest) => continue rest, @gprelude.Cons(x, acc)",
        "    }",
        "  }",
        "}",
        "",
        "///|",
        "fn push_path_prefix(errors : @gprelude.GList[DecodeError], segment : String) -> @gprelude.GList[DecodeError] {",
        "  for cur = errors, rev = (@gprelude.Nil : @gprelude.GList[DecodeError]) {",
        "    match cur {",
        "      @gprelude.Nil => break rev.reverse()",
        "      @gprelude.Cons(DecodeError(expected~, found~, path~), rest) => {",
        "        continue rest, @gprelude.Cons(DecodeError(expected=expected, found=found, path=@gprelude.Cons(segment, path)), rev)",
        "      }",
        "    }",
        "  }",
        "}",
        "",
        "///|",
        "pub fn[T] run(data : @gprelude.Dynamic, decoder : Decoder[T]) -> Result[T, @gprelude.GList[DecodeError]] {",
        "  let Decoder(f) = decoder",
        "  let (val, errors) = f(data)",
        "  match errors {",
        "    @gprelude.Nil => Ok(val)",
        "    _ => Err(errors)",
        "  }",
        "}",
        "",
        "///|",
        "pub fn[T] success(data : T) -> Decoder[T] {",
        "  Decoder(fn(_) { (data, @gprelude.Nil) })",
        "}",
        "",
        "///|",
        "pub fn decode_error(expected : String, found : String) -> @gprelude.GList[DecodeError] {",
        "  @gprelude.Cons(DecodeError(expected=expected, found=found, path=@gprelude.Nil), @gprelude.Nil)",
        "}",
        "",
        "///|",
        "pub fn[T] failure(placeholder : T, expected : String) -> Decoder[T] {",
        "  Decoder(fn(data) { (placeholder, decode_error(expected, @gleam_dynamic.classify(data))) })",
        "}",
        "",
        "///|",
        "pub fn[T] new_primitive_decoder(name : String, decoding_fn : (@gprelude.Dynamic) -> Result[T, T]) -> Decoder[T] {",
        "  Decoder(fn(data) {",
        "    match decoding_fn(data) {",
        "      Ok(v) => (v, @gprelude.Nil)",
        "      Err(placeholder) => (placeholder, decode_error(name, @gleam_dynamic.classify(data)))",
        "    }",
        "  })",
        "}",
        "",
        "///|",
        "pub let string : Decoder[String] = new_primitive_decoder(\"String\", fn(data) {",
        "  match data {",
        "    @gprelude.DynString(s) => Ok(s)",
        "    _ => Err(\"\")",
        "  }",
        "})",
        "",
        "///|",
        "pub let int : Decoder[Int64] = new_primitive_decoder(\"Int\", fn(data) {",
        "  match data {",
        "    @gprelude.DynInt(i) => Ok(i)",
        "    _ => Err(0L)",
        "  }",
        "})",
        "",
        "///|",
        "pub let float : Decoder[Double] = new_primitive_decoder(\"Float\", fn(data) {",
        "  match data {",
        "    @gprelude.DynFloat(f) => Ok(f)",
        "    _ => Err(0.0)",
        "  }",
        "})",
        "",
        "///|",
        "pub let bool : Decoder[Bool] = new_primitive_decoder(\"Bool\", fn(data) {",
        "  match data {",
        "    @gprelude.DynBool(b) => Ok(b)",
        "    _ => Err(false)",
        "  }",
        "})",
        "",
        "///|",
        "pub let bit_array : Decoder[@gprelude.BitArray] = new_primitive_decoder(\"BitArray\", fn(data) {",
        "  match data {",
        "    @gprelude.DynBitArray(ba) => Ok(ba)",
        "    _ => Err(@gprelude.BitArray::empty())",
        "  }",
        "})",
        "",
        "///|",
        "pub let dynamic : Decoder[@gprelude.Dynamic] = Decoder(fn(data) { (data, @gprelude.Nil) })",
        "",
        "///|",
        "pub fn[T] list(inner : Decoder[T]) -> Decoder[@gprelude.GList[T]] {",
        "  let Decoder(item_fn) = inner",
        "  Decoder(fn(data) {",
        "    match data {",
        "      @gprelude.DynList(xs) => {",
        "        for cur = xs, idx = 0L, rev = (@gprelude.Nil : @gprelude.GList[T]), errs = (@gprelude.Nil : @gprelude.GList[DecodeError]) {",
        "          match cur {",
        "            @gprelude.Nil => break (rev.reverse(), errs)",
        "            @gprelude.Cons(el, rest) => {",
        "              let (v, el_errs) = item_fn(el)",
        "              match el_errs {",
        "                @gprelude.Nil => continue rest, idx + 1L, @gprelude.Cons(v, rev), errs",
        "                _ => break (@gprelude.Nil, push_path_prefix(el_errs, idx.to_string()))",
        "              }",
        "            }",
        "          }",
        "        }",
        "      }",
        "      @gprelude.DynArray(arr) => {",
        "        let Decoder(dec_fn) = list(inner)",
        "        dec_fn(@gprelude.DynList(@gprelude.GList::from_array(arr[:])))",
        "      }",
        "      _ => (@gprelude.Nil, decode_error(\"List\", @gleam_dynamic.classify(data)))",
        "    }",
        "  })",
        "}",
        "",
        "///|",
        "pub fn[K : Eq + Hash, V] dict(key_dec : Decoder[K], val_dec : Decoder[V]) -> Decoder[@gleam_dict.Dict[K, V]] {",
        "  let Decoder(kf) = key_dec",
        "  let Decoder(vf) = val_dec",
        "  Decoder(fn(data) {",
        "    match data {",
        "      @gprelude.DynMap(m) => {",
        "        let out : Map[K, V] = Map([])",
        "        let mut errs : @gprelude.GList[DecodeError] = @gprelude.Nil",
        "        m.each(fn(raw_k, raw_v) {",
        "          if errs is @gprelude.Nil {",
        "            let (dk, k_errs) = kf(@gprelude.DynString(raw_k))",
        "            match k_errs {",
        "              @gprelude.Nil => {",
        "                let (dv, v_errs) = vf(raw_v)",
        "                match v_errs {",
        "                  @gprelude.Nil => out.set(dk, dv)",
        "                  _ => errs = push_path_prefix(v_errs, raw_k)",
        "                }",
        "              }",
        "              _ => errs = push_path_prefix(k_errs, \"keys\")",
        "            }",
        "          }",
        "        })",
        "        match errs {",
        "          @gprelude.Nil => (@gleam_dict.Dict::{ inner: out }, @gprelude.Nil)",
        "          _ => (@gleam_dict.new(), errs)",
        "        }",
        "      }",
        "      _ => (@gleam_dict.new(), decode_error(\"Dict\", @gleam_dynamic.classify(data)))",
        "    }",
        "  })",
        "}",
        "",
        "///|",
        "pub fn[T] optional(inner : Decoder[T]) -> Decoder[Option[T]] {",
        "  let Decoder(f) = inner",
        "  Decoder(fn(data) {",
        "    match data {",
        "      @gprelude.DynNull => (None, @gprelude.Nil)",
        "      _ => {",
        "        let (v, errs) = f(data)",
        "        match errs {",
        "          @gprelude.Nil => (Some(v), @gprelude.Nil)",
        "          _ => (None, errs)",
        "        }",
        "      }",
        "    }",
        "  })",
        "}",
        "",
        "///|",
        "fn[T] index_path(path : @gprelude.GList[DynamicKey], cur_data : @gprelude.Dynamic, inner : Decoder[T]) -> (T, @gprelude.GList[DecodeError]) {",
        "  let Decoder(f) = inner",
        "  match path {",
        "    @gprelude.Nil => f(cur_data)",
        "    @gprelude.Cons(key, rest) => {",
        "      let seg = key_to_string(key)",
        "      match bare_index(cur_data, key) {",
        "        Ok(Some(next_data)) => {",
        "          let (v, errs) = index_path(rest, next_data, inner)",
        "          (v, push_path_prefix(errs, seg))",
        "        }",
        "        Ok(None) => {",
        "          let (default_v, _) = f(@gprelude.DynNull)",
        "          (default_v, push_path_prefix(decode_error(\"Field\", \"Nothing\"), seg))",
        "        }",
        "        Err(expected) => {",
        "          let (default_v, _) = f(@gprelude.DynNull)",
        "          (default_v, decode_error(expected, @gleam_dynamic.classify(cur_data)))",
        "        }",
        "      }",
        "    }",
        "  }",
        "}",
        "",
        "///|",
        "pub fn[K : DecodeKey, T, Final] subfield(field_path : @gprelude.GList[K], field_decoder : Decoder[T], next : (T) -> Decoder[Final]) -> Decoder[Final] {",
        "  Decoder(fn(data) {",
        "    let keys = for cur = field_path, rev = (@gprelude.Nil : @gprelude.GList[DynamicKey]) {",
        "      match cur {",
        "        @gprelude.Nil => break rev.reverse()",
        "        @gprelude.Cons(k, rest) => continue rest, @gprelude.Cons(k.to_decode_key(), rev)",
        "      }",
        "    }",
        "    let (v, errs1) = index_path(keys, data, field_decoder)",
        "    let Decoder(next_fn) = next(v)",
        "    let (final_v, errs2) = next_fn(data)",
        "    (final_v, append_lists(errs1, errs2))",
        "  })",
        "}",
        "",
        "///|",
        "pub fn[K : DecodeKey, T, Final] field(field_name : K, field_decoder : Decoder[T], next : (T) -> Decoder[Final]) -> Decoder[Final] {",
        "  subfield(@gprelude.Cons(field_name, @gprelude.Nil), field_decoder, next)",
        "}",
        "",
        "///|",
        "pub fn[K : DecodeKey, T, Final] optional_field(key : K, default : T, field_decoder : Decoder[T], next : (T) -> Decoder[Final]) -> Decoder[Final] {",
        "  let Decoder(f) = field_decoder",
        "  Decoder(fn(data) {",
        "    let dkey = key.to_decode_key()",
        "    let seg = key_to_string(dkey)",
        "    let (v, errs1) = match bare_index(data, dkey) {",
        "      Ok(Some(found)) => {",
        "        let (dv, derrs) = f(found)",
        "        (dv, push_path_prefix(derrs, seg))",
        "      }",
        "      Ok(None) => (default, @gprelude.Nil)",
        "      Err(kind) => (default, push_path_prefix(decode_error(kind, @gleam_dynamic.classify(data)), seg))",
        "    }",
        "    let Decoder(next_fn) = next(v)",
        "    let (final_v, errs2) = next_fn(data)",
        "    (final_v, append_lists(errs1, errs2))",
        "  })",
        "}",
        "",
        "///|",
        "pub fn[K : DecodeKey, T] at(path : @gprelude.GList[K], inner : Decoder[T]) -> Decoder[T] {",
        "  Decoder(fn(data) {",
        "    let keys = for cur = path, rev = (@gprelude.Nil : @gprelude.GList[DynamicKey]) {",
        "      match cur {",
        "        @gprelude.Nil => break rev.reverse()",
        "        @gprelude.Cons(k, rest) => continue rest, @gprelude.Cons(k.to_decode_key(), rev)",
        "      }",
        "    }",
        "    index_path(keys, data, inner)",
        "  })",
        "}",
        "",
        "///|",
        "pub fn[K : DecodeKey, T] optionally_at(path : @gprelude.GList[K], default : T, inner : Decoder[T]) -> Decoder[T] {",
        "  Decoder(fn(data) {",
        "    let Decoder(at_fn) = at(path, inner)",
        "    let (v, errs) = at_fn(data)",
        "    match errs {",
        "      @gprelude.Nil => (v, @gprelude.Nil)",
        "      _ => (default, @gprelude.Nil)",
        "    }",
        "  })",
        "}",
        "",
        "///|",
        "pub fn[A, B] map(decoder : Decoder[A], transformer : (A) -> B) -> Decoder[B] {",
        "  let Decoder(f) = decoder",
        "  Decoder(fn(data) {",
        "    let (v, errs) = f(data)",
        "    (transformer(v), errs)",
        "  })",
        "}",
        "",
        "///|",
        "pub fn[T] map_errors(decoder : Decoder[T], transformer : (@gprelude.GList[DecodeError]) -> @gprelude.GList[DecodeError]) -> Decoder[T] {",
        "  let Decoder(f) = decoder",
        "  Decoder(fn(data) {",
        "    let (v, errs) = f(data)",
        "    (v, transformer(errs))",
        "  })",
        "}",
        "",
        "///|",
        "pub fn[T] collapse_errors(decoder : Decoder[T], name : String) -> Decoder[T] {",
        "  let Decoder(f) = decoder",
        "  Decoder(fn(data) {",
        "    let (v, errs) = f(data)",
        "    match errs {",
        "      @gprelude.Nil => (v, @gprelude.Nil)",
        "      _ => (v, decode_error(name, @gleam_dynamic.classify(data)))",
        "    }",
        "  })",
        "}",
        "",
        "///|",
        "pub fn[A, B] then(decoder : Decoder[A], next : (A) -> Decoder[B]) -> Decoder[B] {",
        "  let Decoder(f) = decoder",
        "  Decoder(fn(data) {",
        "    let (v, errs1) = f(data)",
        "    let Decoder(nf) = next(v)",
        "    let (v2, errs2) = nf(data)",
        "    (v2, append_lists(errs1, errs2))",
        "  })",
        "}",
        "",
        "///|",
        "pub fn[T] one_of(first : Decoder[T], alternatives : @gprelude.GList[Decoder[T]]) -> Decoder[T] {",
        "  Decoder(fn(data) {",
        "    let Decoder(f0) = first",
        "    let (v0, e0) = f0(data)",
        "    match e0 {",
        "      @gprelude.Nil => (v0, @gprelude.Nil)",
        "      _ => {",
        "        for cur = alternatives {",
        "          match cur {",
        "            @gprelude.Nil => break (v0, e0)",
        "            @gprelude.Cons(Decoder(alt_f), rest) => {",
        "              let (av, ae) = alt_f(data)",
        "              match ae {",
        "                @gprelude.Nil => break (av, @gprelude.Nil)",
        "                _ => continue rest",
        "              }",
        "            }",
        "          }",
        "        }",
        "      }",
        "    }",
        "  })",
        "}",
        "",
        "///|",
        "pub fn[T] recursive(inner : () -> Decoder[T]) -> Decoder[T] {",
        "  Decoder(fn(data) {",
        "    let Decoder(f) = inner()",
        "    f(data)",
        "  })",
        "}",
        "",
      ],
      "\n",
    ),
  )
}

fn json_pkg() -> ShimPackage {
  ShimPackage(
    module_name: "gleam/json",
    pkg_dir: "gleam_json",
    imports: [
      #("gprelude", "gprelude"),
      #("gleam_dict", "gleam_dict"),
      #("gleam_dynamic", "gleam_dynamic"),
      #("gleam_dynamic_decode", "gleam_dynamic_decode"),
      #("gleam_string_tree", "gleam_string_tree"),
      #("moonbitlang/core/encoding/utf8", "utf8"),
      #("moonbitlang/core/json", "json"),
      #("moonbitlang/core/string", "str"),
    ],
    deps: [
      "gleam/dict",
      "gleam/dynamic",
      "gleam/dynamic/decode",
      "gleam/string_tree",
    ],
    source: string.join(
      [
        "///|",
        "pub type Json = @json.Json",
        "",
        "///|",
        "#derive(Eq, Debug)",
        "pub(all) enum DecodeError {",
        "  UnexpectedEndOfInput",
        "  UnexpectedByte(String)",
        "  UnexpectedSequence(String)",
        "  UnableToDecode(@gprelude.GList[@gleam_dynamic_decode.DecodeError])",
        "}",
        "",
        "///|",
        "fn json_to_dynamic(j : @json.Json) -> @gprelude.Dynamic {",
        "  match j {",
        "    Null => @gprelude.DynNull",
        "    True => @gprelude.DynBool(true)",
        "    False => @gprelude.DynBool(false)",
        "    String(s) => @gprelude.DynString(s)",
        "    Number(d, repr~) =>",
        "      match repr {",
        "        Some(r) => {",
        "          if !(r.contains(\".\")) && !(r.contains(\"e\")) && !(r.contains(\"E\")) {",
        "            try {",
        "              @gprelude.DynInt(@str.parse_int64(r))",
        "            } catch {",
        "              _ => @gprelude.DynFloat(d)",
        "            }",
        "          } else {",
        "            @gprelude.DynFloat(d)",
        "          }",
        "        }",
        "        None => @gprelude.DynFloat(d)",
        "      }",
        "    Array(arr) => {",
        "      let items = arr.map(json_to_dynamic)",
        "      @gprelude.DynList(@gprelude.GList::from_array(items[:]))",
        "    }",
        "    Object(obj) => {",
        "      let m : Map[String, @gprelude.Dynamic] = Map([])",
        "      obj.each(fn(k, v) { m.set(k, json_to_dynamic(v)) })",
        "      @gprelude.DynMap(m)",
        "    }",
        "  }",
        "}",
        "",
        "///|",
        "pub fn[T] parse(json_str : String, decoder : @gleam_dynamic_decode.Decoder[T]) -> Result[T, DecodeError] {",
        "  let parsed : @json.Json = try {",
        "    @json.parse(json_str, preserve_number_repr=true)",
        "  } catch {",
        "    @json.InvalidEof => return Err(UnexpectedEndOfInput)",
        "    @json.InvalidChar(_, c) => return Err(UnexpectedByte(c.to_string()))",
        "    @json.InvalidNumber(_, s) => return Err(UnexpectedSequence(s))",
        "    @json.InvalidIdentEscape(_) => return Err(UnexpectedSequence(\"escape\"))",
        "    @json.DuplicateKey(_, k) => return Err(UnexpectedSequence(k))",
        "    @json.DepthLimitExceeded => return Err(UnexpectedSequence(\"depth\"))",
        "  }",
        "  let dyn_val = json_to_dynamic(parsed)",
        "  match @gleam_dynamic_decode.run(dyn_val, decoder) {",
        "    Ok(val) => Ok(val)",
        "    Err(errs) => Err(UnableToDecode(errs))",
        "  }",
        "}",
        "",
        "///|",
        "pub fn[T] parse_bits(bits : @gprelude.BitArray, decoder : @gleam_dynamic_decode.Decoder[T]) -> Result[T, DecodeError] {",
        "  let s = try {",
        "    @utf8.decode(bits.data[:])",
        "  } catch {",
        "    _ => return Err(UnexpectedByte(\"\"))",
        "  }",
        "  parse(s, decoder)",
        "}",
        "",
        "///|",
        "pub fn to_string(j : @json.Json) -> String { j.stringify() }",
        "",
        "///|",
        "pub fn to_string_tree(j : @json.Json) -> @gleam_string_tree.StringTree {",
        "  @gleam_string_tree.from_string(j.stringify())",
        "}",
        "",
        "///|",
        "pub fn string(input : String) -> @json.Json { @json.Json::string(input) }",
        "",
        "///|",
        "pub fn bool(input : Bool) -> @json.Json { @json.Json::boolean(input) }",
        "",
        "///|",
        "pub fn int(input : Int64) -> @json.Json {",
        "  @json.Json::number(input.to_double(), repr=input.to_string())",
        "}",
        "",
        "///|",
        "pub fn float(input : Double) -> @json.Json { @json.Json::number(input) }",
        "",
        "///|",
        "pub fn null() -> @json.Json { @json.Json::null() }",
        "",
        "///|",
        "pub fn[T] nullable(input : Option[T], inner_type : (T) -> @json.Json) -> @json.Json {",
        "  match input {",
        "    Some(v) => inner_type(v)",
        "    None => null()",
        "  }",
        "}",
        "",
        "///|",
        "pub fn object(entries : @gprelude.GList[(String, @json.Json)]) -> @json.Json {",
        "  let m : Map[String, @json.Json] = Map([])",
        "  for cur = entries {",
        "    match cur {",
        "      @gprelude.Nil => break @json.Json::object(m)",
        "      @gprelude.Cons((k, v), rest) => {",
        "        m.set(k, v)",
        "        continue rest",
        "      }",
        "    }",
        "  }",
        "}",
        "",
        "///|",
        "pub fn[T] array(entries : @gprelude.GList[T], inner_type : (T) -> @json.Json) -> @json.Json {",
        "  let arr : Array[@json.Json] = []",
        "  for cur = entries {",
        "    match cur {",
        "      @gprelude.Nil => break @json.Json::array(arr)",
        "      @gprelude.Cons(x, rest) => {",
        "        arr.push(inner_type(x))",
        "        continue rest",
        "      }",
        "    }",
        "  }",
        "}",
        "",
        "///|",
        "pub fn preprocessed_array(entries : @gprelude.GList[@json.Json]) -> @json.Json {",
        "  @json.Json::array(entries.to_array())",
        "}",
        "",
        "///|",
        "pub fn[K, V] dict(d : @gleam_dict.Dict[K, V], keys : (K) -> String, values : (V) -> @json.Json) -> @json.Json {",
        "  let m : Map[String, @json.Json] = Map([])",
        "  d.inner.each(fn(k, v) { m.set(keys(k), values(v)) })",
        "  @json.Json::object(m)",
        "}",
        "",
      ],
      "\n",
    ),
  )
}
