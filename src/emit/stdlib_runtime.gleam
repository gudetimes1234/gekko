fn option_pkg() -> ShimPackage {
  ShimPackage(
    module_name: "gleam/option",
    pkg_dir: "gleam_option",
    imports: [#("gprelude", "gprelude")],
    deps: [],
    source: string.join(
      [
        "///|",
        "pub fn[T] all(list : @gprelude.GList[Option[T]]) -> Option[@gprelude.GList[T]] {",
        "  for cur = list, rev = (@gprelude.Nil : @gprelude.GList[T]) {",
        "    match cur {",
        "      @gprelude.Nil => break Some(rev.reverse())",
        "      @gprelude.Cons(None, _) => break None",
        "      @gprelude.Cons(Some(v), rest) => continue rest, @gprelude.Cons(v, rev)",
        "    }",
        "  }",
        "}",
        "",
        "///|",
        "pub fn[T] is_some(option : Option[T]) -> Bool {",
        "  match option {",
        "    Some(_) => true",
        "    None => false",
        "  }",
        "}",
        "",
        "///|",
        "pub fn[T] is_none(option : Option[T]) -> Bool {",
        "  match option {",
        "    Some(_) => false",
        "    None => true",
        "  }",
        "}",
        "",
        "///|",
        "pub fn[T, E] to_result(option : Option[T], e : E) -> Result[T, E] {",
        "  match option {",
        "    Some(v) => Ok(v)",
        "    None => Err(e)",
        "  }",
        "}",
        "",
        "///|",
        "pub fn[T, E] from_result(result : Result[T, E]) -> Option[T] {",
        "  match result {",
        "    Ok(v) => Some(v)",
        "    Err(_) => None",
        "  }",
        "}",
        "",
        "///|",
        "pub fn[T] unwrap(option : Option[T], default : T) -> T {",
        "  match option {",
        "    Some(v) => v",
        "    None => default",
        "  }",
        "}",
        "",
        "///|",
        "pub fn[T] lazy_unwrap(option : Option[T], default : () -> T) -> T {",
        "  match option {",
        "    Some(v) => v",
        "    None => default()",
        "  }",
        "}",
        "",
        "///|",
        "pub fn[A, B] map(option : Option[A], fun : (A) -> B) -> Option[B] {",
        "  match option {",
        "    Some(v) => Some(fun(v))",
        "    None => None",
        "  }",
        "}",
        "",
        "///|",
        "pub fn[T] flatten(option : Option[Option[T]]) -> Option[T] {",
        "  match option {",
        "    Some(inner) => inner",
        "    None => None",
        "  }",
        "}",
        "",
        "///|",
        "pub fn[A, B] then(option : Option[A], apply : (A) -> Option[B]) -> Option[B] {",
        "  match option {",
        "    Some(v) => apply(v)",
        "    None => None",
        "  }",
        "}",
        "",
        "///|",
        "pub fn[T] or(first : Option[T], second : Option[T]) -> Option[T] {",
        "  match first {",
        "    Some(_) => first",
        "    None => second",
        "  }",
        "}",
        "",
        "///|",
        "pub fn[T] lazy_or(first : Option[T], second : () -> Option[T]) -> Option[T] {",
        "  match first {",
        "    Some(_) => first",
        "    None => second()",
        "  }",
        "}",
        "",
        "///|",
        "pub fn[T] values(options : @gprelude.GList[Option[T]]) -> @gprelude.GList[T] {",
        "  for cur = options, rev = (@gprelude.Nil : @gprelude.GList[T]) {",
        "    match cur {",
        "      @gprelude.Nil => break rev.reverse()",
        "      @gprelude.Cons(Some(v), rest) => continue rest, @gprelude.Cons(v, rev)",
        "      @gprelude.Cons(None, rest) => continue rest, rev",
        "    }",
        "  }",
        "}",
        "",
      ],
      "\n",
    ),
  )
}

fn result_pkg() -> ShimPackage {
  ShimPackage(
    module_name: "gleam/result",
    pkg_dir: "gleam_result",
    imports: [#("gprelude", "gprelude")],
    deps: [],
    source: string.join(
      [
        "///|",
        "pub fn[A, E] is_ok(result : Result[A, E]) -> Bool {",
        "  result is Ok(_)",
        "}",
        "",
        "///|",
        "pub fn[A, E] is_error(result : Result[A, E]) -> Bool {",
        "  result is Err(_)",
        "}",
        "",
        "///|",
        "pub fn[A, B, E] map(result : Result[A, E], fun : (A) -> B) -> Result[B, E] {",
        "  match result {",
        "    Ok(x) => Ok(fun(x))",
        "    Err(e) => Err(e)",
        "  }",
        "}",
        "",
        "///|",
        "pub fn[A, E, F] map_error(result : Result[A, E], fun : (E) -> F) -> Result[A, F] {",
        "  match result {",
        "    Ok(x) => Ok(x)",
        "    Err(e) => Err(fun(e))",
        "  }",
        "}",
        "",
        "///|",
        "pub fn[A, E] flatten(result : Result[Result[A, E], E]) -> Result[A, E] {",
        "  match result {",
        "    Ok(x) => x",
        "    Err(e) => Err(e)",
        "  }",
        "}",
        "",
        "///|",
        "pub fn[A, B, E] try_(result : Result[A, E], fun : (A) -> Result[B, E]) -> Result[B, E] {",
        "  match result {",
        "    Ok(x) => fun(x)",
        "    Err(e) => Err(e)",
        "  }",
        "}",
        "",
        "///|",
        "pub fn[A, E] unwrap(result : Result[A, E], default : A) -> A {",
        "  match result {",
        "    Ok(x) => x",
        "    Err(_) => default",
        "  }",
        "}",
        "",
        "///|",
        "pub fn[A, E] lazy_unwrap(result : Result[A, E], default : () -> A) -> A {",
        "  match result {",
        "    Ok(x) => x",
        "    Err(_) => default()",
        "  }",
        "}",
        "",
        "///|",
        "pub fn[A, E] unwrap_error(result : Result[A, E], default : E) -> E {",
        "  match result {",
        "    Ok(_) => default",
        "    Err(e) => e",
        "  }",
        "}",
        "",
        "///|",
        "pub fn[A] unwrap_both(result : Result[A, A]) -> A {",
        "  match result {",
        "    Ok(a) | Err(a) => a",
        "  }",
        "}",
        "",
        "///|",
        "pub fn[A, E] or(first : Result[A, E], second : Result[A, E]) -> Result[A, E] {",
        "  match first {",
        "    Ok(_) => first",
        "    Err(_) => second",
        "  }",
        "}",
        "",
        "///|",
        "pub fn[A, E] lazy_or(first : Result[A, E], second : () -> Result[A, E]) -> Result[A, E] {",
        "  match first {",
        "    Ok(_) => first",
        "    Err(_) => second()",
        "  }",
        "}",
        "",
        "///|",
        "pub fn[A, E] all(results : @gprelude.GList[Result[A, E]]) -> Result[@gprelude.GList[A], E] {",
        "  for cur = results, rev = (@gprelude.Nil : @gprelude.GList[A]) {",
        "    match cur {",
        "      @gprelude.Nil => break Ok(rev.reverse())",
        "      @gprelude.Cons(Err(e), _) => break Err(e)",
        "      @gprelude.Cons(Ok(v), rest) => continue rest, @gprelude.Cons(v, rev)",
        "    }",
        "  }",
        "}",
        "",
        "///|",
        "pub fn[A, E] partition(results : @gprelude.GList[Result[A, E]]) -> (@gprelude.GList[A], @gprelude.GList[E]) {",
        "  for cur = results, oks = (@gprelude.Nil : @gprelude.GList[A]), errs = (@gprelude.Nil : @gprelude.GList[E]) {",
        "    match cur {",
        "      @gprelude.Nil => break (oks.reverse(), errs.reverse())",
        "      @gprelude.Cons(Ok(v), rest) => continue rest, @gprelude.Cons(v, oks), errs",
        "      @gprelude.Cons(Err(e), rest) => continue rest, oks, @gprelude.Cons(e, errs)",
        "    }",
        "  }",
        "}",
        "",
        "///|",
        "pub fn[A, B, E] replace(result : Result[A, E], value : B) -> Result[B, E] {",
        "  match result {",
        "    Ok(_) => Ok(value)",
        "    Err(e) => Err(e)",
        "  }",
        "}",
        "",
        "///|",
        "pub fn[A, E, F] replace_error(result : Result[A, E], error : F) -> Result[A, F] {",
        "  match result {",
        "    Ok(v) => Ok(v)",
        "    Err(_) => Err(error)",
        "  }",
        "}",
        "",
        "///|",
        "pub fn[A, E] values(results : @gprelude.GList[Result[A, E]]) -> @gprelude.GList[A] {",
        "  for cur = results, rev = (@gprelude.Nil : @gprelude.GList[A]) {",
        "    match cur {",
        "      @gprelude.Nil => break rev.reverse()",
        "      @gprelude.Cons(Ok(v), rest) => continue rest, @gprelude.Cons(v, rev)",
        "      @gprelude.Cons(Err(_), rest) => continue rest, rev",
        "    }",
        "  }",
        "}",
        "",
        "///|",
        "pub fn[A, E, F] try_recover(result : Result[A, E], fun : (E) -> Result[A, F]) -> Result[A, F] {",
        "  match result {",
        "    Ok(v) => Ok(v)",
        "    Err(e) => fun(e)",
        "  }",
        "}",
        "",
      ],
      "\n",
    ),
  )
}

fn int_pkg() -> ShimPackage {
  ShimPackage(
    module_name: "gleam/int",
    pkg_dir: "gleam_int",
    imports: [
      #("gprelude", "gprelude"),
      #("gleam_order", "gleam_order"),
      #("moonbitlang/core/math", "math"),
      #("moonbitlang/core/string", "str"),
    ],
    deps: ["gleam/order"],
    source: string.join(
      [
        "///|",
        "pub fn absolute_value(x : Int64) -> Int64 {",
        "  if x < 0L { -x } else { x }",
        "}",
        "",
        "///|",
        "pub fn power(base : Int64, exponent : Double) -> Result[Double, Unit] {",
        "  if exponent < 0.0 && base == 0L {",
        "    Err(())",
        "  } else if base < 0L && @math.floor(exponent) != exponent {",
        "    Err(())",
        "  } else {",
        "    Ok(@math.pow(base.to_double(), exponent))",
        "  }",
        "}",
        "",
        "///|",
        "pub fn square_root(x : Int64) -> Result[Double, Unit] {",
        "  if x < 0L { Err(()) } else { Ok(x.to_double().sqrt()) }",
        "}",
        "",
        "///|",
        "pub fn parse(s : String) -> Result[Int64, Unit] {",
        "  base_parse(s, 10L)",
        "}",
        "",
        "///|",
        "pub fn base_parse(s : String, base : Int64) -> Result[Int64, Unit] {",
        "  if base < 2L || base > 36L || s == \"\" {",
        "    return Err(())",
        "  }",
        "  let chars = s.iter().collect()",
        "  let mut i = 0",
        "  let mut sign = 1L",
        "  if chars[0] == '-' {",
        "    sign = -1L",
        "    i = 1",
        "  } else if chars[0] == '+' {",
        "    i = 1",
        "  }",
        "  if i >= chars.length() {",
        "    return Err(())",
        "  }",
        "  let mut acc = 0L",
        "  while i < chars.length() {",
        "    let c = chars[i]",
        "    let digit = if c >= '0' && c <= '9' {",
        "      (c.to_int() - '0'.to_int()).to_int64()",
        "    } else if c >= 'a' && c <= 'z' {",
        "      (c.to_int() - 'a'.to_int() + 10).to_int64()",
        "    } else if c >= 'A' && c <= 'Z' {",
        "      (c.to_int() - 'A'.to_int() + 10).to_int64()",
        "    } else {",
        "      -1L",
        "    }",
        "    if digit < 0L || digit >= base {",
        "      return Err(())",
        "    }",
        "    acc = acc * base + sign * digit",
        "    i = i + 1",
        "  }",
        "  Ok(acc)",
        "}",
        "",
        "///|",
        "pub fn to_string(x : Int64) -> String {",
        "  x.to_string()",
        "}",
        "",
        "///|",
        "pub fn to_base_string(x : Int64, base : Int64) -> Result[String, Unit] {",
        "  if base < 2L || base > 36L {",
        "    return Err(())",
        "  }",
        "  if x == 0L {",
        "    return Ok(\"0\")",
        "  }",
        "  let digits = \"0123456789ABCDEFGHIJKLMNOPQRSTUVWXYZ\"",
        "  let neg = x < 0L",
        "  let mut n = if neg { -x } else { x }",
        "  let rev : Array[Char] = []",
        "  while n > 0L {",
        "    let d = (n % base).to_int()",
        "    rev.push(digits[d].to_int().unsafe_to_char())",
        "    n = n / base",
        "  }",
        "  let buf = StringBuilder()",
        "  if neg {",
        "    buf.write_char('-')",
        "  }",
        "  let mut i = rev.length() - 1",
        "  while i >= 0 {",
        "    buf.write_char(rev[i])",
        "    i = i - 1",
        "  }",
        "  Ok(buf.to_string())",
        "}",
        "",
        "///|",
        "pub fn to_base2(x : Int64) -> String {",
        "  match to_base_string(x, 2L) { Ok(s) => s; Err(_) => \"\" }",
        "}",
        "",
        "///|",
        "pub fn to_base8(x : Int64) -> String {",
        "  match to_base_string(x, 8L) { Ok(s) => s; Err(_) => \"\" }",
        "}",
        "",
        "///|",
        "pub fn to_base16(x : Int64) -> String {",
        "  match to_base_string(x, 16L) { Ok(s) => s; Err(_) => \"\" }",
        "}",
        "",
        "///|",
