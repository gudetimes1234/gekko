import emit/pkg_config
import filepath
import gleam/dict
import gleam/list
import gleam/result
import gleam/set.{type Set}
import gleam/string
import simplifile

/// A built-in MoonBit shim package backing a `gleam/*` standard or JSON module.
pub type ShimPackage {
  ShimPackage(
    module_name: String,
    pkg_dir: String,
    imports: List(#(String, String)),
    deps: List(String),
    source: String,
  )
}

/// Return True if `module_name` is handled by `stdlib_runtime`.
pub fn is_builtin_stdlib_module(module_name: String) -> Bool {
  case module_name {
    "gleam/order"
    | "gleam/bool"
    | "gleam/pair"
    | "gleam/option"
    | "gleam/result"
    | "gleam/int"
    | "gleam/float"
    | "gleam/string"
    | "gleam/list"
    | "gleam/dict"
    | "gleam/io"
    | "gleam/string_tree"
    | "gleam/bit_array"
    | "gleam/dynamic"
    | "gleam/dynamic/decode"
    | "gleam/json" -> True
    _ -> False
  }
}

/// Return all 16 built-in `gleam/*` shim packages.
pub fn all_shim_packages() -> List(ShimPackage) {
  [
    order_pkg(),
    bool_pkg(),
    pair_pkg(),
    option_pkg(),
    result_pkg(),
    int_pkg(),
    float_pkg(),
    string_pkg(),
    list_pkg(),
    dict_pkg(),
    io_pkg(),
    string_tree_pkg(),
    bit_array_pkg(),
    dynamic_pkg(),
    decode_pkg(),
    json_pkg(),
  ]
}

/// Compute the transitive closure of built-in shim packages needed for
/// `referenced_modules`.
pub fn resolve_shim_packages(
  referenced_modules: List(String),
) -> List(ShimPackage) {
  let by_name =
    all_shim_packages()
    |> list.fold(dict.new(), fn(acc, pkg) {
      dict.insert(acc, pkg.module_name, pkg)
    })

  let initial = list.filter(referenced_modules, is_builtin_stdlib_module)
  let visited = collect_deps(initial, by_name, set.new())

  all_shim_packages()
  |> list.filter(fn(pkg) { set.contains(visited, pkg.module_name) })
}

/// Write all required `gleam/*` shim packages into `out_dir`.
pub fn emit_shim_packages(
  project_name: String,
  out_dir: String,
  referenced_modules: List(String),
) -> Result(Nil, String) {
  let pkgs = resolve_shim_packages(referenced_modules)
  list.try_each(pkgs, fn(pkg) {
    let dir = filepath.join(out_dir, pkg.pkg_dir)
    use _ <- result.try(
      simplifile.create_directory_all(dir)
      |> result.map_error(fn(err) {
        "Failed to create shim dir "
        <> dir
        <> ": "
        <> simplifile.describe_error(err)
      }),
    )
    let pkg_cfg = pkg_config.emit_moon_pkg(project_name, pkg.imports, False)
    use _ <- result.try(
      simplifile.write(to: filepath.join(dir, "moon.pkg"), contents: pkg_cfg)
      |> result.map_error(fn(err) {
        "Failed to write shim moon.pkg: " <> simplifile.describe_error(err)
      }),
    )
    simplifile.write(
      to: filepath.join(dir, pkg.pkg_dir <> ".mbt"),
      contents: pkg.source,
    )
    |> result.map_error(fn(err) {
      "Failed to write shim .mbt: " <> simplifile.describe_error(err)
    })
  })
}

fn collect_deps(
  queue: List(String),
  by_name: dict.Dict(String, ShimPackage),
  visited: Set(String),
) -> Set(String) {
  case queue {
    [] -> visited
    [head, ..tail] ->
      case set.contains(visited, head) {
        True -> collect_deps(tail, by_name, visited)
        False ->
          case dict.get(by_name, head) {
            Error(_) -> collect_deps(tail, by_name, visited)
            Ok(pkg) ->
              collect_deps(
                list.append(pkg.deps, tail),
                by_name,
                set.insert(visited, head),
              )
          }
      }
  }
}

fn order_pkg() -> ShimPackage {
  ShimPackage(
    module_name: "gleam/order",
    pkg_dir: "gleam_order",
    imports: [],
    deps: [],
    source: string.join(
      [
        "///|",
        "#derive(Eq, Debug, Hash)",
        "pub(all) enum Order {",
        "  Lt",
        "  Eq",
        "  Gt",
        "}",
        "",
        "///|",
        "pub fn negate(order : Order) -> Order {",
        "  match order {",
        "    Lt => Gt",
        "    Eq => Eq",
        "    Gt => Lt",
        "  }",
        "}",
        "",
        "///|",
        "pub fn to_int(order : Order) -> Int64 {",
        "  match order {",
        "    Lt => -1L",
        "    Eq => 0L",
        "    Gt => 1L",
        "  }",
        "}",
        "",
        "///|",
        "pub fn compare(a : Order, b : Order) -> Order {",
        "  match (a, b) {",
        "    (Lt, Lt) | (Eq, Eq) | (Gt, Gt) => Eq",
        "    (Lt, _) | (Eq, Gt) => Lt",
        "    (Gt, _) | (Eq, Lt) => Gt",
        "  }",
        "}",
        "",
        "///|",
        "pub fn[T] reverse(orderer : (T, T) -> Order) -> (T, T) -> Order {",
        "  fn(a, b) { orderer(b, a) }",
        "}",
        "",
        "///|",
        "pub fn break_tie(order : Order, other : Order) -> Order {",
        "  match order {",
        "    Lt | Gt => order",
        "    Eq => other",
        "  }",
        "}",
        "",
        "///|",
        "pub fn lazy_break_tie(order : Order, comparison : () -> Order) -> Order {",
        "  match order {",
        "    Lt | Gt => order",
        "    Eq => comparison()",
        "  }",
        "}",
        "",
      ],
      "\n",
    ),
  )
}

