        "  from.inner.each(fn(k, v) { m.set(k, v) })",
        "  { inner: m }",
        "}",
        "",
        "///|",
        "pub fn[K : Eq + Hash, V] delete(d : Dict[K, V], key : K) -> Dict[K, V] {",
        "  let m = d.inner.copy()",
        "  m.remove(key)",
        "  { inner: m }",
        "}",
        "",
        "///|",
        "pub fn[K : Eq + Hash, V] drop(d : Dict[K, V], disallowed : @gprelude.GList[K]) -> Dict[K, V] {",
        "  let m = d.inner.copy()",
        "  for cur = disallowed {",
        "    match cur {",
        "      @gprelude.Nil => break { inner: m }",
        "      @gprelude.Cons(k, rest) => {",
        "        m.remove(k)",
        "        continue rest",
        "      }",
        "    }",
        "  }",
        "}",
        "",
        "///|",
        "pub fn[K : Eq + Hash, V] upsert(d : Dict[K, V], key : K, fun : (Option[V]) -> V) -> Dict[K, V] {",
        "  let m = d.inner.copy()",
        "  let prev = match m.get(key) { Some(v) => Some(v); None => None }",
        "  m.set(key, fun(prev))",
        "  { inner: m }",
        "}",
        "",
        "///|",
        "pub fn[K, V, Acc] fold(d : Dict[K, V], initial : Acc, fun : (Acc, K, V) -> Acc) -> Acc {",
        "  let mut acc = initial",
        "  d.inner.each(fn(k, v) { acc = fun(acc, k, v) })",
        "  acc",
        "}",
        "",
        "///|",
        "pub fn[K, V, Ign] each(d : Dict[K, V], fun : (K, V) -> Ign) -> Unit {",
        "  d.inner.each(fn(k, v) { @prelude.ignore(fun(k, v)) })",
        "}",
        "",
        "///|",
        "pub fn[K : Eq + Hash, V] combine(d : Dict[K, V], other : Dict[K, V], fun : (V, V) -> V) -> Dict[K, V] {",
        "  let m = d.inner.copy()",
        "  other.inner.each(fn(k, v2) {",
        "    match m.get(k) {",
        "      Some(v1) => m.set(k, fun(v1, v2))",
        "      None => m.set(k, v2)",
        "    }",
        "  })",
        "  { inner: m }",
        "}",
        "",
        "///|",
        "pub fn[K : Eq + Hash, V] group(key : (V) -> K, xs : @gprelude.GList[V]) -> Dict[K, @gprelude.GList[V]] {",
        "  let m : Map[K, Array[V]] = Map([])",
        "  for cur = xs {",
        "    match cur {",
        "      @gprelude.Nil => break",
        "      @gprelude.Cons(v, rest) => {",
        "        let k = key(v)",
        "        match m.get(k) {",
        "          Some(arr) => arr.push(v)",
        "          None => m.set(k, [v])",
        "        }",
        "        continue rest",
        "      }",
        "    }",
        "  }",
        "  let out : Map[K, @gprelude.GList[V]] = Map([])",
        "  m.each(fn(k, arr) { out.set(k, @gprelude.GList::from_array(arr[:])) })",
        "  { inner: out }",
        "}",
        "",
      ],
      "\n",
    ),
  )
}

