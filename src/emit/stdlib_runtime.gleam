      [
        "///|",
        "pub type BitArray = @gprelude.BitArray",
        "",
        "///|",
        "pub fn from_string(x : String) -> @gprelude.BitArray {",
        "  @gprelude.BitArray::from_string(x)",
        "}",
        "",
        "///|",
        "pub fn byte_size(x : @gprelude.BitArray) -> Int64 { x.byte_size() }",
        "",
        "///|",
        "pub fn bit_size(x : @gprelude.BitArray) -> Int64 { x.byte_size() * 8L }",
        "",
        "///|",
        "pub fn pad_to_bytes(x : @gprelude.BitArray) -> @gprelude.BitArray { x }",
        "",
        "///|",
        "pub fn append(first : @gprelude.BitArray, second : @gprelude.BitArray) -> @gprelude.BitArray {",
        "  @gprelude.BitArray::concat([first, second][:])",
        "}",
        "",
        "///|",
        "pub fn slice(bits : @gprelude.BitArray, at : Int64, take : Int64) -> Result[@gprelude.BitArray, Unit] {",
        "  bits.slice(at, take)",
        "}",
        "",
        "///|",
        "pub fn is_utf8(bits : @gprelude.BitArray) -> Bool {",
        "  try {",
        "    @prelude.ignore(@utf8.decode(bits.data[:]))",
        "    true",
        "  } catch {",
        "    _ => false",
        "  }",
        "}",
        "",
        "///|",
        "pub fn to_string(bits : @gprelude.BitArray) -> Result[String, Unit] {",
        "  try {",
        "    Ok(@utf8.decode(bits.data[:]))",
        "  } catch {",
        "    _ => Err(())",
        "  }",
        "}",
        "",
        "///|",
        "pub fn concat(bit_arrays : @gprelude.GList[@gprelude.BitArray]) -> @gprelude.BitArray {",
        "  @gprelude.BitArray::concat(bit_arrays.to_array()[:])",
        "}",
        "",
        "///|",
        "pub fn base16_encode(input : @gprelude.BitArray) -> String {",
        "  let hex = \"0123456789ABCDEF\"",
        "  let buf = StringBuilder()",
        "  for b in input.data {",
        "    let v = b.to_int()",
        "    buf.write_char(hex[v >> 4].to_int().unsafe_to_char())",
        "    buf.write_char(hex[v & 0xF].to_int().unsafe_to_char())",
        "  }",
        "  buf.to_string()",
        "}",
        "",
        "///|",
        "fn hex_val(c : Char) -> Int {",
        "  if c >= '0' && c <= '9' { c.to_int() - '0'.to_int() }",
        "  else if c >= 'a' && c <= 'f' { c.to_int() - 'a'.to_int() + 10 }",
        "  else if c >= 'A' && c <= 'F' { c.to_int() - 'A'.to_int() + 10 }",
        "  else { -1 }",
        "}",
        "",
        "///|",
        "pub fn base16_decode(input : String) -> Result[@gprelude.BitArray, Unit] {",
        "  let chars = input.iter().collect()",
        "  if chars.length() % 2 != 0 { return Err(()) }",
        "  let buf = @buffer.Buffer()",
        "  let mut i = 0",
        "  while i < chars.length() {",
        "    let hi = hex_val(chars[i])",
        "    let lo = hex_val(chars[i + 1])",
        "    if hi < 0 || lo < 0 { return Err(()) }",
        "    buf.write_byte(((hi << 4) | lo).to_byte())",
        "    i = i + 2",
        "  }",
        "  Ok({ data: buf.to_bytes() })",
        "}",
        "",
        "///|",
        "pub fn inspect(input : @gprelude.BitArray) -> String {",
        "  let buf = StringBuilder()",
        "  buf.write_string(\"<<\")",
        "  let mut i = 0",
        "  while i < input.data.length() {",
        "    if i > 0 { buf.write_string(\", \") }",
        "    buf.write_string(input.data[i].to_int().to_string())",
        "    i = i + 1",
        "  }",
        "  buf.write_string(\">>\")",
        "  buf.to_string()",
        "}",
        "",
        "///|",
        "pub fn compare(a : @gprelude.BitArray, b : @gprelude.BitArray) -> @gleam_order.Order {",
        "  let cmp = a.data.lexical_compare(b.data)",
        "  if cmp < 0 { @gleam_order.Lt } else if cmp > 0 { @gleam_order.Gt } else { @gleam_order.Eq }",
        "}",
        "",
        "///|",
        "pub fn starts_with(bits : @gprelude.BitArray, prefix : @gprelude.BitArray) -> Bool {",
        "  bits.data.has_prefix(prefix.data[:])",
        "}",
        "",
      ],
      "\n",
    ),
  )
}

