        "    @gprelude.Nil => Err(())",
        "    @gprelude.Cons(x, _) => Ok(x)",
        "  }",
        "}",
        "",
        "///|",
        "pub fn[T] rest(xs : @gprelude.GList[T]) -> Result[@gprelude.GList[T], Unit] {",
        "  match xs {",
        "    @gprelude.Nil => Err(())",
        "    @gprelude.Cons(_, tl) => Ok(tl)",
        "  }",
        "}",
        "",
        "///|",
        "pub fn[K : Eq + Hash, V] group(xs : @gprelude.GList[V], key : (V) -> K) -> @gleam_dict.Dict[K, @gprelude.GList[V]] {",
        "  let m : Map[K, Array[V]] = Map([])",
        "  for cur = xs {",
        "    match cur {",
        "      @gprelude.Nil => break",
        "      @gprelude.Cons(v, rest) => {",
        "        let k = key(v)",
        "        match m.get(k) {",
        "          Some(arr) => arr.push(v)",
        "          None => m.set(k, [v])",
        "        }",
        "        continue rest",
        "      }",
        "    }",
        "  }",
        "  let out : Map[K, @gprelude.GList[V]] = Map([])",
        "  m.each(fn(k, arr) { out.set(k, @gprelude.GList::from_array(arr[:])) })",
        "  @gleam_dict.Dict::{ inner: out }",
        "}",
        "",
        "///|",
        "pub fn[T] filter(xs : @gprelude.GList[T], pred : (T) -> Bool) -> @gprelude.GList[T] {",
        "  for cur = xs, rev = (@gprelude.Nil : @gprelude.GList[T]) {",
        "    match cur {",
        "      @gprelude.Nil => break rev.reverse()",
        "      @gprelude.Cons(x, rest) => continue rest, if pred(x) { @gprelude.Cons(x, rev) } else { rev }",
        "    }",
        "  }",
        "}",
        "",
        "///|",
        "pub fn[A, B, E] filter_map(xs : @gprelude.GList[A], fun : (A) -> Result[B, E]) -> @gprelude.GList[B] {",
        "  for cur = xs, rev = (@gprelude.Nil : @gprelude.GList[B]) {",
        "    match cur {",
        "      @gprelude.Nil => break rev.reverse()",
        "      @gprelude.Cons(x, rest) => match fun(x) {",
        "        Ok(y) => continue rest, @gprelude.Cons(y, rev)",
        "        Err(_) => continue rest, rev",
        "      }",
        "    }",
        "  }",
        "}",
        "",
        "///|",
        "pub fn[A, B] map(xs : @gprelude.GList[A], fun : (A) -> B) -> @gprelude.GList[B] {",
        "  for cur = xs, rev = (@gprelude.Nil : @gprelude.GList[B]) {",
        "    match cur {",
        "      @gprelude.Nil => break rev.reverse()",
        "      @gprelude.Cons(x, rest) => continue rest, @gprelude.Cons(fun(x), rev)",
        "    }",
        "  }",
        "}",
        "",
        "///|",
        "pub fn[A, B, C] map2(xs : @gprelude.GList[A], ys : @gprelude.GList[B], fun : (A, B) -> C) -> @gprelude.GList[C] {",
        "  for cx = xs, cy = ys, rev = (@gprelude.Nil : @gprelude.GList[C]) {",
        "    match (cx, cy) {",
        "      (@gprelude.Cons(x, rx), @gprelude.Cons(y, ry)) => continue rx, ry, @gprelude.Cons(fun(x, y), rev)",
        "      _ => break rev.reverse()",
        "    }",
        "  }",
        "}",
        "",
        "///|",
        "pub fn[A, B, Acc] map_fold(xs : @gprelude.GList[A], initial : Acc, fun : (Acc, A) -> (Acc, B)) -> (Acc, @gprelude.GList[B]) {",
        "  for cur = xs, acc = initial, rev = (@gprelude.Nil : @gprelude.GList[B]) {",
        "    match cur {",
        "      @gprelude.Nil => break (acc, rev.reverse())",
        "      @gprelude.Cons(x, rest) => {",
        "        let (next_acc, y) = fun(acc, x)",
        "        continue rest, next_acc, @gprelude.Cons(y, rev)",
        "      }",
        "    }",
        "  }",
        "}",
        "",
        "///|",
        "pub fn[A, B] index_map(xs : @gprelude.GList[A], fun : (A, Int64) -> B) -> @gprelude.GList[B] {",
        "  for cur = xs, idx = 0L, rev = (@gprelude.Nil : @gprelude.GList[B]) {",
        "    match cur {",
        "      @gprelude.Nil => break rev.reverse()",
        "      @gprelude.Cons(x, rest) => continue rest, idx + 1L, @gprelude.Cons(fun(x, idx), rev)",
        "    }",
        "  }",
        "}",
        "",
        "///|",
        "pub fn[A, B, E] try_map(xs : @gprelude.GList[A], fun : (A) -> Result[B, E]) -> Result[@gprelude.GList[B], E] {",
        "  for cur = xs, rev = (@gprelude.Nil : @gprelude.GList[B]) {",
        "    match cur {",
        "      @gprelude.Nil => break Ok(rev.reverse())",
        "      @gprelude.Cons(x, rest) => match fun(x) {",
        "        Ok(y) => continue rest, @gprelude.Cons(y, rev)",
        "        Err(e) => break Err(e)",
        "      }",
        "    }",
        "  }",
        "}",
        "",
        "///|",
        "pub fn[T] drop(xs : @gprelude.GList[T], n : Int64) -> @gprelude.GList[T] {",
        "  for cur = xs, rem = n {",
        "    if rem <= 0L { break cur }",
        "    match cur {",
        "      @gprelude.Nil => break @gprelude.Nil",
        "      @gprelude.Cons(_, rest) => continue rest, rem - 1L",
        "    }",
        "  }",
        "}",
        "",
        "///|",
        "pub fn[T] take(xs : @gprelude.GList[T], n : Int64) -> @gprelude.GList[T] {",
        "  for cur = xs, rem = n, rev = (@gprelude.Nil : @gprelude.GList[T]) {",
        "    if rem <= 0L { break rev.reverse() }",
        "    match cur {",
        "      @gprelude.Nil => break rev.reverse()",
        "      @gprelude.Cons(x, rest) => continue rest, rem - 1L, @gprelude.Cons(x, rev)",
        "    }",
        "  }",
        "}",
        "",
        "///|",
        "pub fn[T] new() -> @gprelude.GList[T] { @gprelude.Nil }",
        "",
        "///|",
        "pub fn[T] wrap(item : T) -> @gprelude.GList[T] { @gprelude.Cons(item, @gprelude.Nil) }",
        "",
        "///|",
        "pub fn[T] append(first : @gprelude.GList[T], second : @gprelude.GList[T]) -> @gprelude.GList[T] {",
        "  for cur = first.reverse(), acc = second {",
        "    match cur {",
        "      @gprelude.Nil => break acc",
        "      @gprelude.Cons(x, rest) => continue rest, @gprelude.Cons(x, acc)",
        "    }",
        "  }",
        "}",
        "",
        "///|",
        "pub fn[T] prepend(xs : @gprelude.GList[T], item : T) -> @gprelude.GList[T] { @gprelude.Cons(item, xs) }",
        "",
        "///|",
        "pub fn[T] flatten(lists : @gprelude.GList[@gprelude.GList[T]]) -> @gprelude.GList[T] {",
        "  for cur = lists, rev = (@gprelude.Nil : @gprelude.GList[T]) {",
        "    match cur {",
        "      @gprelude.Nil => break rev.reverse()",
        "      @gprelude.Cons(sub, rest) => {",
        "        let next_rev = for s = sub, r = rev {",
        "          match s {",
        "            @gprelude.Nil => break r",
        "            @gprelude.Cons(x, sr) => continue sr, @gprelude.Cons(x, r)",
        "          }",
        "        }",
        "        continue rest, next_rev",
        "      }",
        "    }",
        "  }",
        "}",
        "",
        "///|",
        "pub fn[A, B] flat_map(xs : @gprelude.GList[A], fun : (A) -> @gprelude.GList[B]) -> @gprelude.GList[B] {",
        "  flatten(map(xs, fun))",
        "}",
        "",
        "///|",
        "pub fn[A, Acc] fold(xs : @gprelude.GList[A], initial : Acc, fun : (Acc, A) -> Acc) -> Acc {",
        "  for cur = xs, acc = initial {",
        "    match cur {",
        "      @gprelude.Nil => break acc",
        "      @gprelude.Cons(x, rest) => continue rest, fun(acc, x)",
        "    }",
        "  }",
        "}",
        "",
        "///|",
        "pub fn[A, Acc] fold_right(xs : @gprelude.GList[A], initial : Acc, fun : (Acc, A) -> Acc) -> Acc {",
        "  fold(xs.reverse(), initial, fun)",
        "}",
        "",
        "///|",
        "pub fn[A, Acc] index_fold(xs : @gprelude.GList[A], initial : Acc, fun : (Acc, A, Int64) -> Acc) -> Acc {",
        "  for cur = xs, acc = initial, idx = 0L {",
        "    match cur {",
        "      @gprelude.Nil => break acc",
        "      @gprelude.Cons(x, rest) => continue rest, fun(acc, x, idx), idx + 1L",
        "    }",
        "  }",
        "}",
        "",
        "///|",
        "pub fn[A, Acc, E] try_fold(xs : @gprelude.GList[A], initial : Acc, fun : (Acc, A) -> Result[Acc, E]) -> Result[Acc, E] {",
        "  for cur = xs, acc = initial {",
        "    match cur {",
        "      @gprelude.Nil => break Ok(acc)",
        "      @gprelude.Cons(x, rest) => match fun(acc, x) {",
        "        Ok(next) => continue rest, next",
        "        Err(e) => break Err(e)",
        "      }",
        "    }",
        "  }",
        "}",
        "",
        "///|",
        "pub fn[A, Acc] fold_until(xs : @gprelude.GList[A], initial : Acc, fun : (Acc, A) -> ContinueOrStop[Acc]) -> Acc {",
        "  for cur = xs, acc = initial {",
        "    match cur {",
        "      @gprelude.Nil => break acc",
        "      @gprelude.Cons(x, rest) => match fun(acc, x) {",
        "        Continue(next) => continue rest, next",
        "        Stop(done) => break done",
        "      }",
        "    }",
        "  }",
        "}",
        "",
        "///|",
        "pub fn[T] find(xs : @gprelude.GList[T], pred : (T) -> Bool) -> Result[T, Unit] {",
        "  for cur = xs {",
        "    match cur {",
        "      @gprelude.Nil => break Err(())",
        "      @gprelude.Cons(x, rest) => if pred(x) { break Ok(x) } else { continue rest }",
        "    }",
        "  }",
        "}",
        "",
        "///|",
        "pub fn[A, B, E] find_map(xs : @gprelude.GList[A], fun : (A) -> Result[B, E]) -> Result[B, Unit] {",
        "  for cur = xs {",
        "    match cur {",
        "      @gprelude.Nil => break Err(())",
        "      @gprelude.Cons(x, rest) => match fun(x) {",
        "        Ok(v) => break Ok(v)",
        "        Err(_) => continue rest",
        "      }",
        "    }",
        "  }",
        "}",
        "",
        "///|",
        "pub fn[T] all(xs : @gprelude.GList[T], pred : (T) -> Bool) -> Bool {",
        "  for cur = xs {",
        "    match cur {",
        "      @gprelude.Nil => break true",
        "      @gprelude.Cons(x, rest) => if pred(x) { continue rest } else { break false }",
        "    }",
        "  }",
        "}",
        "",
        "///|",
        "pub fn[T] any(xs : @gprelude.GList[T], pred : (T) -> Bool) -> Bool {",
        "  for cur = xs {",
        "    match cur {",
        "      @gprelude.Nil => break false",
        "      @gprelude.Cons(x, rest) => if pred(x) { break true } else { continue rest }",
        "    }",
        "  }",
        "}",
        "",
        "///|",
        "pub fn[A, B] zip(xs : @gprelude.GList[A], ys : @gprelude.GList[B]) -> @gprelude.GList[(A, B)] {",
        "  for cx = xs, cy = ys, rev = (@gprelude.Nil : @gprelude.GList[(A, B)]) {",
        "    match (cx, cy) {",
        "      (@gprelude.Cons(x, rx), @gprelude.Cons(y, ry)) => continue rx, ry, @gprelude.Cons((x, y), rev)",
        "      _ => break rev.reverse()",
        "    }",
        "  }",
        "}",
        "",
        "///|",
        "pub fn[A, B] strict_zip(xs : @gprelude.GList[A], ys : @gprelude.GList[B]) -> Result[@gprelude.GList[(A, B)], Unit] {",
        "  for cx = xs, cy = ys, rev = (@gprelude.Nil : @gprelude.GList[(A, B)]) {",
        "    match (cx, cy) {",
        "      (@gprelude.Nil, @gprelude.Nil) => break Ok(rev.reverse())",
        "      (@gprelude.Cons(x, rx), @gprelude.Cons(y, ry)) => continue rx, ry, @gprelude.Cons((x, y), rev)",
        "      _ => break Err(())",
        "    }",
        "  }",
        "}",
        "",
        "///|",
        "pub fn[A, B] unzip(xs : @gprelude.GList[(A, B)]) -> (@gprelude.GList[A], @gprelude.GList[B]) {",
        "  for cur = xs, ra = (@gprelude.Nil : @gprelude.GList[A]), rb = (@gprelude.Nil : @gprelude.GList[B]) {",
        "    match cur {",
        "      @gprelude.Nil => break (ra.reverse(), rb.reverse())",
        "      @gprelude.Cons((a, b), rest) => continue rest, @gprelude.Cons(a, ra), @gprelude.Cons(b, rb)",
        "    }",
        "  }",
        "}",
        "",
        "///|",
        "pub fn[T] intersperse(xs : @gprelude.GList[T], elem : T) -> @gprelude.GList[T] {",
        "  match xs {",
        "    @gprelude.Nil => @gprelude.Nil",
        "    @gprelude.Cons(x, rest) => {",
        "      for cur = rest, rev = (@gprelude.Cons(x, @gprelude.Nil) : @gprelude.GList[T]) {",
        "        match cur {",
        "          @gprelude.Nil => break rev.reverse()",
        "          @gprelude.Cons(y, r) => continue r, @gprelude.Cons(y, @gprelude.Cons(elem, rev))",
        "        }",
        "      }",
        "    }",
        "  }",
        "}",
        "",
        "///|",
        "pub fn[T : Eq] unique(xs : @gprelude.GList[T]) -> @gprelude.GList[T] {",
        "  let arr : Array[T] = []",
        "  for cur = xs {",
        "    match cur {",
        "      @gprelude.Nil => break @gprelude.GList::from_array(arr[:])",
        "      @gprelude.Cons(x, rest) => {",
        "        if !(arr.contains(x)) { arr.push(x) }",
        "        continue rest",
        "      }",
        "    }",
        "  }",
        "}",
        "",
        "///|",
        "pub fn[T] sort(xs : @gprelude.GList[T], cmp : (T, T) -> @gleam_order.Order) -> @gprelude.GList[T] {",
        "  let arr = xs.to_array()",
        "  arr.sort_by(fn(a, b) { @gleam_order.to_int(cmp(a, b)).to_int() })",
        "  @gprelude.GList::from_array(arr[:])",
        "}",
        "",
        "///|",
        "pub fn range(from : Int64, to : Int64) -> @gprelude.GList[Int64] {",
        "  let step = if from <= to { 1L } else { -1L }",
        "  for i = from, rev = (@gprelude.Nil : @gprelude.GList[Int64]) {",
        "    if i == to {",
        "      break @gprelude.Cons(i, rev).reverse()",
        "    } else {",
        "      continue i + step, @gprelude.Cons(i, rev)",
        "    }",
        "  }",
        "}",
        "",
        "///|",
        "pub fn[T] repeat(item : T, times : Int64) -> @gprelude.GList[T] {",
        "  for n = times, acc = (@gprelude.Nil : @gprelude.GList[T]) {",
        "    if n <= 0L { break acc } else { continue n - 1L, @gprelude.Cons(item, acc) }",
        "  }",
        "}",
        "",
        "///|",
        "pub fn[T] split(xs : @gprelude.GList[T], index : Int64) -> (@gprelude.GList[T], @gprelude.GList[T]) {",
        "  for cur = xs, rem = index, rev = (@gprelude.Nil : @gprelude.GList[T]) {",
        "    if rem <= 0L { break (rev.reverse(), cur) }",
        "    match cur {",
        "      @gprelude.Nil => break (rev.reverse(), @gprelude.Nil)",
        "      @gprelude.Cons(x, rest) => continue rest, rem - 1L, @gprelude.Cons(x, rev)",
        "    }",
        "  }",
        "}",
        "",
        "///|",
        "pub fn[T] split_while(xs : @gprelude.GList[T], pred : (T) -> Bool) -> (@gprelude.GList[T], @gprelude.GList[T]) {",
        "  for cur = xs, rev = (@gprelude.Nil : @gprelude.GList[T]) {",
        "    match cur {",
        "      @gprelude.Nil => break (rev.reverse(), @gprelude.Nil)",
        "      @gprelude.Cons(x, rest) => if pred(x) { continue rest, @gprelude.Cons(x, rev) } else { break (rev.reverse(), cur) }",
        "    }",
        "  }",
        "}",
        "",
        "///|",
        "pub fn[K : Eq, V] key_find(xs : @gprelude.GList[(K, V)], key : K) -> Result[V, Unit] {",
        "  for cur = xs {",
        "    match cur {",
        "      @gprelude.Nil => break Err(())",
        "      @gprelude.Cons((k, v), rest) => if k == key { break Ok(v) } else { continue rest }",
        "    }",
        "  }",
        "}",
        "",
        "///|",
        "pub fn[K : Eq, V] key_filter(xs : @gprelude.GList[(K, V)], key : K) -> @gprelude.GList[V] {",
        "  for cur = xs, rev = (@gprelude.Nil : @gprelude.GList[V]) {",
        "    match cur {",
        "      @gprelude.Nil => break rev.reverse()",
        "      @gprelude.Cons((k, v), rest) => continue rest, if k == key { @gprelude.Cons(v, rev) } else { rev }",
        "    }",
        "  }",
        "}",
        "",
        "///|",
        "pub fn[K : Eq, V] key_pop(xs : @gprelude.GList[(K, V)], key : K) -> Result[(V, @gprelude.GList[(K, V)]), Unit] {",
        "  for cur = xs, rev = (@gprelude.Nil : @gprelude.GList[(K, V)]) {",
        "    match cur {",
        "      @gprelude.Nil => break Err(())",
        "      @gprelude.Cons((k, v), rest) => if k == key {",
        "        break Ok((v, append(rev.reverse(), rest)))",
        "      } else {",
        "        continue rest, @gprelude.Cons((k, v), rev)",
        "      }",
        "    }",
        "  }",
        "}",
        "",
        "///|",
        "pub fn[K : Eq, V] key_set(xs : @gprelude.GList[(K, V)], key : K, val : V) -> @gprelude.GList[(K, V)] {",
        "  for cur = xs, rev = (@gprelude.Nil : @gprelude.GList[(K, V)]) {",
        "    match cur {",
        "      @gprelude.Nil => break @gprelude.Cons((key, val), rev).reverse()",
        "      @gprelude.Cons((k, v), rest) => if k == key {",
        "        break append(rev.reverse(), @gprelude.Cons((key, val), rest))",
        "      } else {",
        "        continue rest, @gprelude.Cons((k, v), rev)",
        "      }",
        "    }",
        "  }",
        "}",
        "",
        "///|",
        "pub fn[T, Ign] each(xs : @gprelude.GList[T], f : (T) -> Ign) -> Unit {",
        "  for cur = xs {",
        "    match cur {",
        "      @gprelude.Nil => break ()",
        "      @gprelude.Cons(x, rest) => {",
        "        @prelude.ignore(f(x))",
        "        continue rest",
        "      }",
        "    }",
        "  }",
        "}",
        "",
        "///|",
        "pub fn[T, Ign, E] try_each(xs : @gprelude.GList[T], f : (T) -> Result[Ign, E]) -> Result[Unit, E] {",
        "  for cur = xs {",
        "    match cur {",
        "      @gprelude.Nil => break Ok(())",
        "      @gprelude.Cons(x, rest) => match f(x) {",
        "        Ok(_) => continue rest",
        "        Err(e) => break Err(e)",
        "      }",
        "    }",
        "  }",
        "}",
        "",
        "///|",
        "pub fn[T] partition(xs : @gprelude.GList[T], pred : (T) -> Bool) -> (@gprelude.GList[T], @gprelude.GList[T]) {",
        "  for cur = xs, ts = (@gprelude.Nil : @gprelude.GList[T]), fs = (@gprelude.Nil : @gprelude.GList[T]) {",
        "    match cur {",
        "      @gprelude.Nil => break (ts.reverse(), fs.reverse())",
        "      @gprelude.Cons(x, rest) => if pred(x) {",
        "        continue rest, @gprelude.Cons(x, ts), fs",
        "      } else {",
        "        continue rest, ts, @gprelude.Cons(x, fs)",
        "      }",
        "    }",
        "  }",
        "}",
        "",
        "///|",
        "pub fn[T] drop_while(xs : @gprelude.GList[T], pred : (T) -> Bool) -> @gprelude.GList[T] {",
        "  for cur = xs {",
        "    match cur {",
        "      @gprelude.Nil => break @gprelude.Nil",
        "      @gprelude.Cons(x, rest) => if pred(x) { continue rest } else { break cur }",
        "    }",
        "  }",
        "}",
        "",
        "///|",
        "pub fn[T] take_while(xs : @gprelude.GList[T], pred : (T) -> Bool) -> @gprelude.GList[T] {",
        "  split_while(xs, pred).0",
        "}",
        "",
        "///|",
        "pub fn[T, K : Eq] chunk(xs : @gprelude.GList[T], by : (T) -> K) -> @gprelude.GList[@gprelude.GList[T]] {",
        "  match xs {",
        "    @gprelude.Nil => @gprelude.Nil",
        "    @gprelude.Cons(first_el, rest) => {",
        "      for cur = rest, cur_key = by(first_el), cur_grp = (@gprelude.Cons(first_el, @gprelude.Nil) : @gprelude.GList[T]), rev_groups = (@gprelude.Nil : @gprelude.GList[@gprelude.GList[T]]) {",
        "        match cur {",
        "          @gprelude.Nil => break @gprelude.Cons(cur_grp.reverse(), rev_groups).reverse()",
        "          @gprelude.Cons(x, r) => {",
        "            let k = by(x)",
        "            if k == cur_key {",
        "              continue r, cur_key, @gprelude.Cons(x, cur_grp), rev_groups",
        "            } else {",
        "              continue r, k, @gprelude.Cons(x, @gprelude.Nil), @gprelude.Cons(cur_grp.reverse(), rev_groups)",
        "            }",
        "          }",
        "        }",
        "      }",
        "    }",
        "  }",
        "}",
        "",
        "///|",
        "pub fn[T] sized_chunk(xs : @gprelude.GList[T], count_ : Int64) -> @gprelude.GList[@gprelude.GList[T]] {",
        "  let size = if count_ <= 0L { 1L } else { count_ }",
        "  for cur = xs, cur_len = 0L, cur_grp = (@gprelude.Nil : @gprelude.GList[T]), rev_groups = (@gprelude.Nil : @gprelude.GList[@gprelude.GList[T]]) {",
        "    match cur {",
        "      @gprelude.Nil => {",
        "        if cur_len > 0L {",
        "          break @gprelude.Cons(cur_grp.reverse(), rev_groups).reverse()",
        "        } else {",
        "          break rev_groups.reverse()",
        "        }",
        "      }",
        "      @gprelude.Cons(x, rest) => {",
        "        let next_grp = @gprelude.Cons(x, cur_grp)",
        "        let next_len = cur_len + 1L",
        "        if next_len == size {",
        "          continue rest, 0L, @gprelude.Nil, @gprelude.Cons(next_grp.reverse(), rev_groups)",
        "        } else {",
        "          continue rest, next_len, next_grp, rev_groups",
        "        }",
        "      }",
        "    }",
        "  }",
        "}",
        "",
        "///|",
        "pub fn[T] reduce(xs : @gprelude.GList[T], fun : (T, T) -> T) -> Result[T, Unit] {",
        "  match xs {",
        "    @gprelude.Nil => Err(())",
        "    @gprelude.Cons(first_el, rest) => Ok(fold(rest, first_el, fun))",
        "  }",
        "}",
        "",
        "///|",
        "pub fn[A, Acc] scan(xs : @gprelude.GList[A], initial : Acc, fun : (Acc, A) -> Acc) -> @gprelude.GList[Acc] {",
        "  for cur = xs, acc = initial, rev = (@gprelude.Nil : @gprelude.GList[Acc]) {",
        "    match cur {",
        "      @gprelude.Nil => break rev.reverse()",
        "      @gprelude.Cons(x, rest) => {",
        "        let next = fun(acc, x)",
        "        continue rest, next, @gprelude.Cons(next, rev)",
        "      }",
        "    }",
        "  }",
        "}",
        "",
        "///|",
        "pub fn[T] last(xs : @gprelude.GList[T]) -> Result[T, Unit] {",
        "  match xs {",
        "    @gprelude.Nil => Err(())",
        "    @gprelude.Cons(x, rest) => {",
        "      for cur = rest, prev = x {",
        "        match cur {",
        "          @gprelude.Nil => break Ok(prev)",
        "          @gprelude.Cons(y, r) => continue r, y",
        "        }",
        "      }",
        "    }",
        "  }",
        "}",
        "",
      ],
      "\n",
    ),
  )
}

