        "          None => ()",
        "        }",
        "        continue rest",
        "      }",
        "    }",
        "  }",
        "}",
        "",
        "///|",
        "pub fn[K : Eq + Hash, V] merge(into : Dict[K, V], from : Dict[K, V]) -> Dict[K, V] {",
