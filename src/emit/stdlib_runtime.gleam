        "  for cur = xs {",
        "    match cur {",
        "      @gprelude.Nil => break false",
        "      @gprelude.Cons(x, rest) => if x == elem { break true } else { continue rest }",
        "    }",
        "  }",
        "}",
        "",
        "///|",
        "pub fn[T] first(xs : @gprelude.GList[T]) -> Result[T, Unit] {",
