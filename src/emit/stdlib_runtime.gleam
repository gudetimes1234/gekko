        "  for cur = xs, acc = 0L {",
        "    match cur {",
        "      @gprelude.Nil => break acc",
        "      @gprelude.Cons(x, rest) => continue rest, if predicate(x) { acc + 1L } else { acc }",
        "    }",
        "  }",
        "}",
        "",
        "///|",
        "pub fn[T] reverse(xs : @gprelude.GList[T]) -> @gprelude.GList[T] { xs.reverse() }",
